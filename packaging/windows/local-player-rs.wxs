<?xml version="1.0" encoding="utf-8"?>
<!--
  Local Player MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build local-player-rs.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=0.1.0 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files\Local Player RS (the folder keeps its pre-rename name, so
  an installed copy upgrades in place) with a Start Menu shortcut. The installer shows the standard
  WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUID below belong to Local Player alone - they are NEW GUIDs, not
  the ones of the old Local-Player: Windows Installer treats every package sharing an UpgradeCode
  as one product, so reusing them would make the two apps refuse to install together ("a newer
  version is already installed") or silently uninstall each other. Never copy these into (or from)
  a sibling app of the suite.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Local Player"
      Manufacturer="Local Player RS contributors"
      Version="$(var.Version)"
      UpgradeCode="73BFB89E-155A-4757-B17D-16FD9E2518ED"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Local Player media player" Manufacturer="Local Player RS contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Local Player is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LocalPlayerRsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LocalPlayerRsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Styx-Studios/Local-Player" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Styx-Studios/Local-Player/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Styx-Studios/Local-Player/issues" />

    <!-- Installer UI: WixUI_Minimal is welcome + license, progress, then a finish page so people
         can see the install worked. Its dialogs and bitmaps are WiX's own (WixToolset.UI.wixext);
         package.ps1 builds the license RTF. The finish page offers to launch Local Player (ticked
         by default) through WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never
         show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Local Player" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LocalPlayerRsExe]" />
    <CustomAction Id="LaunchLocalPlayerRs" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLocalPlayerRs"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Local Player RS" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Local Player" Level="1">
      <ComponentGroupRef Id="LocalPlayerRsFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LocalPlayerRsFiles" Directory="INSTALLFOLDER">
      <Component Id="LocalPlayerRsApp" Guid="41C3F61C-D541-4BF1-9DE3-C318E51DACE5">
        <File Id="LocalPlayerRsExe" Source="$(var.BinDir)\local-player-rs.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Local Player"
              Description="Local Player media player" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LocalPlayerRsIcon.ico" IconIndex="0" />
          <!-- Alias de busca: a busca do Windows casa o nome do atalho, e todo app da
               suíte começa com Local — "player" puro não acharia nada. -->
          <Shortcut Id="AliasShortcut" Directory="ProgramMenuFolder" Name="Player"
              Description="Local Player media player" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LocalPlayerRsIcon.ico" IconIndex="0" />
          <!-- Atalho no desktop (per-machine = desktop comum, visível pra todos os usuários). -->
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Local Player"
              Description="Local Player media player" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LocalPlayerRsIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\local-player-rs.exe" Value="[#LocalPlayerRsExe]" Type="string" />
        <!-- Where this MSI installed the app. The app's own updater (craft_update) reads it
             (HKLM for a per-machine install) under the suite's key to know this is an MSI
             install, so it updates with the new MSI rather than the portable zip. The key's
             last segment is the app's display name (craft_update::App::name). -->
        <RegistryValue Root="HKLM" Key="Software\Anon5T4R\Local Player RS" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />

        <!-- "Open with" and Settings > Default apps, through the Default Programs registration (ProgID,
             OpenWithProgids, Capabilities, RegisteredApplications). Same list as the Linux MimeType: the formats the player opens (MEDIA_EXTS).
             Never takes over an extension: the default value is left alone and the user chooses. -->
        <ProgId Id="LocalPlayerRs.Media" Description="Media File" Icon="LocalPlayerRsExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalPlayerRs.Media\shell\open\command" Value="&quot;[#LocalPlayerRsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp4\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.m4v\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mov\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mkv\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webm\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp3\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.flac\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.opus\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ogg\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.wav\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.m4a\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.aac\OpenWithProgids" Name="LocalPlayerRs.Media" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe" Name="FriendlyAppName" Value="Local Player" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\shell\open\command" Value="&quot;[#LocalPlayerRsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".mp4" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".m4v" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".mov" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".mkv" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".webm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".opus" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".ogg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".m4a" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\local-player-rs.exe\SupportedTypes" Name=".aac" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities" Name="ApplicationName" Value="Local Player" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities" Name="ApplicationDescription" Value="Audio and video player" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities" Name="ApplicationIcon" Value="[#LocalPlayerRsExe],0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".mp4" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".m4v" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".mov" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".mkv" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".webm" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".mp3" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".flac" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".opus" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".ogg" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".wav" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".m4a" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalPlayerRs\Capabilities\FileAssociations" Name=".aac" Value="LocalPlayerRs.Media" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="LocalPlayerRs" Value="Software\LocalPlayerRs\Capabilities" Type="string" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
